{
  "name": "lung-screening-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings src",
    "format": "prettier --write src",
    "check": "npm run typecheck && npm run lint && npm run build",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-states.mjs",
    "compare:figma": "mkdir -p docs && node scripts/compare-figma.mjs > docs/figma-measurements.md"
  },
  "dependencies": {
    "openseadragon": "^6.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/openseadragon": "^5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
