# Copy to .env.local and adjust.

# mock = in-browser fixtures (default) · http = real model service
VITE_INFERENCE_MODE=mock

# Model service (http mode). Must allow CORS from the Vite origin (http://localhost:5173).
VITE_API_BASE_URL=http://localhost:8000

# Per-request timeout for JSON calls such as GET /jobs/:id, in ms. Uploads are not time-limited.
VITE_API_TIMEOUT_MS=30000

# Mock mode only: simulated server run time per job, in ms (real GPU runs take minutes).
VITE_MOCK_DURATION_MS=16000
